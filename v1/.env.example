KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8765/oauth/kakao/callback
KAKAO_TOKEN_FILE=/data/kakao-token.json
KAKAO_MESSAGE_LINK_URL=https://github.com/QuietString/cgv-open-push
KAKAO_REQUEST_TIMEOUT_SECONDS=15
CGV_LOOKAHEAD_DAYS=14
CGV_POLL_INTERVAL_SECONDS=300
CGV_REQUEST_INTERVAL_SECONDS=1
CGV_RETRY_INITIAL_SECONDS=60
CGV_RETRY_MAX_SECONDS=900
